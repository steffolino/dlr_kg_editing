[
    {
        "entityType": "Material",
        "label": "Material",
        "description": "A raw, processed, or recycled material used in manufacturing or supply chains.",
        "fields": [
            {
                "key": "label",
                "label": "Material Name",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Identity",
                "helpText": "The common name of the material (e.g. 'Recycled Polypropylene PP-R')."
            },
            {
                "key": "materialCategory",
                "label": "Material Category",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "plastic",
                    "metal",
                    "bio-based",
                    "composite",
                    "ceramic",
                    "textile",
                    "other"
                ],
                "group": "Classification",
                "helpText": "Select the primary material category. Choose 'other' if none applies and add a note."
            },
            {
                "key": "recyclingRate",
                "label": "Recycling Rate (%)",
                "datatype": "number",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "min": 0,
                "max": 100,
                "group": "Circularity",
                "helpText": "Estimated percentage of the material that can be recycled under current industrial conditions (0–100)."
            },
            {
                "key": "hazardClass",
                "label": "Hazard Classification",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "none",
                    "low",
                    "medium",
                    "high",
                    "critical"
                ],
                "group": "Safety",
                "helpText": "Hazard level based on EU CLP/GHS or RoHS. When in doubt, choose 'medium' and add a note for curator review."
            },
            {
                "key": "allowedLifecyclePhase",
                "label": "Allowed Lifecycle Phases",
                "datatype": "multiselect",
                "required": false,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "production",
                    "use",
                    "maintenance",
                    "end-of-life",
                    "remanufacturing"
                ],
                "group": "Lifecycle",
                "helpText": "Lifecycle phases where this material is applicable. Controlled by curators to ensure graph consistency."
            },
            {
                "key": "confidence",
                "label": "Data Confidence",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "low",
                    "medium",
                    "high",
                    "verified"
                ],
                "group": "Quality",
                "helpText": "Curator-assessed confidence level. 'Verified' means third-party evidence is linked."
            },
            {
                "key": "provenanceSource",
                "label": "Provenance Source",
                "datatype": "string",
                "required": false,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Provenance",
                "helpText": "Where this data originates (e.g. 'EcoDatabase 2023 Annual Report, section 4.2'). Managed by curators."
            },
            {
                "key": "lastReviewedAt",
                "label": "Last Reviewed",
                "datatype": "date",
                "required": false,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Provenance",
                "helpText": "Date the record was last reviewed and validated by a curator."
            },
            {
                "key": "notes",
                "label": "Notes",
                "datatype": "textarea",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Additional",
                "helpText": "Free-text notes. Include context, caveats, or data quality concerns."
            }
        ]
    },
    {
        "entityType": "Component",
        "label": "Component",
        "description": "A manufactured part or assembly that incorporates one or more materials.",
        "fields": [
            {
                "key": "label",
                "label": "Component Name",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Identity",
                "helpText": "Full commercial or engineering name of the component."
            },
            {
                "key": "primaryMaterial",
                "label": "Primary Material (ID)",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Composition",
                "helpText": "The entity ID of the dominant material (e.g. 'MAT-001'). Must reference an existing Material entity."
            },
            {
                "key": "assemblyProcess",
                "label": "Assembly Process",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "injection-moulding",
                    "compression-moulding",
                    "welding",
                    "adhesive-bonding",
                    "mechanical-fastening",
                    "casting",
                    "extrusion",
                    "other"
                ],
                "group": "Manufacturing",
                "helpText": "Primary manufacturing or assembly process used to produce this component."
            },
            {
                "key": "weight",
                "label": "Weight",
                "datatype": "number",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "min": 0,
                "group": "Physical",
                "helpText": "Component mass in the unit specified below."
            },
            {
                "key": "unit",
                "label": "Weight Unit",
                "datatype": "select",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "g",
                    "kg",
                    "t"
                ],
                "group": "Physical",
                "defaultValue": "kg",
                "helpText": "Unit for the weight value."
            },
            {
                "key": "repairabilityScore",
                "label": "Repairability Score (1–10)",
                "datatype": "number",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "min": 1,
                "max": 10,
                "group": "Circularity",
                "helpText": "Repairability rating (1 = not repairable, 10 = fully repairable). Based on French repairability index methodology."
            },
            {
                "key": "confidence",
                "label": "Data Confidence",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "low",
                    "medium",
                    "high",
                    "verified"
                ],
                "group": "Quality",
                "helpText": "Curator-assessed confidence in this component's data."
            },
            {
                "key": "notes",
                "label": "Notes",
                "datatype": "textarea",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Additional",
                "helpText": "Design-for-disassembly notes, special handling, or data caveats."
            }
        ]
    },
    {
        "entityType": "SupplierStatement",
        "label": "Supplier Statement",
        "description": "A formal claim or declaration made by a supplier regarding material origin, recycled content, or environmental properties.",
        "fields": [
            {
                "key": "label",
                "label": "Statement Title",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Identity",
                "helpText": "A descriptive title for this supplier statement."
            },
            {
                "key": "supplierName",
                "label": "Supplier Name",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Supplier",
                "helpText": "Full legal name of the supplier making the statement."
            },
            {
                "key": "claimType",
                "label": "Claim Type",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "recycled-content",
                    "bio-based-content",
                    "carbon-footprint",
                    "environmental-certification",
                    "chemical-compliance",
                    "other"
                ],
                "group": "Claim",
                "helpText": "The category of the supplier's claim."
            },
            {
                "key": "claimedValue",
                "label": "Claimed Value",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Claim",
                "helpText": "The specific claim value (e.g. '82% post-consumer recycled content by weight')."
            },
            {
                "key": "validUntil",
                "label": "Valid Until",
                "datatype": "date",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Validity",
                "helpText": "Expiry date of the supplier statement. Leave blank if open-ended."
            },
            {
                "key": "verificationStatus",
                "label": "Verification Status",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "self-declared",
                    "third-party-verified",
                    "certified",
                    "disputed"
                ],
                "group": "Validity",
                "helpText": "Level of external verification. 'Third-party-verified' or 'certified' requires an EvidenceDocument."
            },
            {
                "key": "confidence",
                "label": "Data Confidence",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "low",
                    "medium",
                    "high",
                    "verified"
                ],
                "group": "Quality",
                "helpText": "Overall confidence in this statement's accuracy."
            },
            {
                "key": "notes",
                "label": "Notes",
                "datatype": "textarea",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Additional",
                "helpText": "Context about the statement, linked certificates, or follow-up actions."
            }
        ]
    },
    {
        "entityType": "RecyclingProcess",
        "label": "Recycling Process",
        "description": "A defined process or route for recycling a specific material at end of life.",
        "fields": [
            {
                "key": "label",
                "label": "Process Name",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Identity",
                "helpText": "Common name of this recycling process or route."
            },
            {
                "key": "targetMaterial",
                "label": "Target Material (ID)",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Scope",
                "helpText": "The material entity ID this process is designed to recycle (e.g. 'MAT-001')."
            },
            {
                "key": "processType",
                "label": "Process Type",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "mechanical",
                    "chemical",
                    "biological",
                    "thermal",
                    "dissolution",
                    "other"
                ],
                "group": "Process",
                "helpText": "Primary type of recycling technology."
            },
            {
                "key": "efficiency",
                "label": "Process Efficiency (%)",
                "datatype": "number",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "min": 0,
                "max": 100,
                "group": "Performance",
                "helpText": "Material yield efficiency of the process (0–100%). Include source in notes."
            },
            {
                "key": "certificationBody",
                "label": "Certification Body",
                "datatype": "string",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Certification",
                "helpText": "Name of the certifying or auditing body (e.g. 'Recyclass', 'TÜV')."
            },
            {
                "key": "outputQuality",
                "label": "Output Quality",
                "datatype": "select",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "poor",
                    "acceptable",
                    "good",
                    "premium"
                ],
                "group": "Performance",
                "helpText": "Quality grade of the recycled output material."
            },
            {
                "key": "confidence",
                "label": "Data Confidence",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "low",
                    "medium",
                    "high",
                    "verified"
                ],
                "group": "Quality",
                "helpText": "Curator-assessed confidence in this process record."
            },
            {
                "key": "notes",
                "label": "Notes",
                "datatype": "textarea",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Additional",
                "helpText": "Technical details, limitations, applicable standards, or data gaps."
            }
        ]
    },
    {
        "entityType": "EvidenceDocument",
        "label": "Evidence Document",
        "description": "A formal document providing evidence or certification supporting other knowledge graph records.",
        "fields": [
            {
                "key": "label",
                "label": "Document Title",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Identity",
                "helpText": "Full title of the evidence document."
            },
            {
                "key": "documentType",
                "label": "Document Type",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "certification",
                    "test-report",
                    "audit-report",
                    "declaration",
                    "standard",
                    "technical-datasheet",
                    "other"
                ],
                "group": "Classification",
                "helpText": "Type of document. Choose the most specific applicable type."
            },
            {
                "key": "issuer",
                "label": "Issuing Body",
                "datatype": "string",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Origin",
                "helpText": "Organisation or body that issued or authored this document."
            },
            {
                "key": "issuedAt",
                "label": "Issue Date",
                "datatype": "date",
                "required": true,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Validity",
                "helpText": "Date the document was officially issued."
            },
            {
                "key": "expiresAt",
                "label": "Expiry Date",
                "datatype": "date",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Validity",
                "helpText": "Date on which this document expires or needs renewal. Leave blank if permanent."
            },
            {
                "key": "coverageScope",
                "label": "Coverage Scope",
                "datatype": "string",
                "required": false,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Scope",
                "helpText": "Comma-separated entity IDs covered by this document (e.g. 'MAT-001, REC-001')."
            },
            {
                "key": "confidence",
                "label": "Data Confidence",
                "datatype": "select",
                "required": true,
                "editableByRoles": [
                    "curator",
                    "ontology-engineer"
                ],
                "allowedValues": [
                    "low",
                    "medium",
                    "high",
                    "verified"
                ],
                "group": "Quality",
                "helpText": "Confidence in the authenticity and accuracy of this evidence document."
            },
            {
                "key": "notes",
                "label": "Notes",
                "datatype": "textarea",
                "required": false,
                "editableByRoles": [
                    "domain-expert",
                    "curator",
                    "ontology-engineer"
                ],
                "group": "Additional",
                "helpText": "Additional context, document URL, certificate number, or related entities."
